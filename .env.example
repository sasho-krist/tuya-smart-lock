# Tuya IoT Platform → Cloud → Development → вашият проект → Overview
# Регион (data center): Central Europe https://openapi.tuyaeu.com | Western Europe https://openapi-weaz.tuyaeu.com
# US https://openapi.tuyaus.com | China https://openapi.tuyacn.com | India https://openapi.tuyain.com
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=

# Една или повече брави: device_id:Етикет, разделени със запетая
TUYA_DEVICE_IDS=bf0123456789abcdef:Входна врата

# Часова зона за имейлите и audit log-а
APP_TIMEZONE=Europe/Sofia

# Хеш на паролата за уеб интерфейса. Генерира се с: php bin/hash-password.php
APP_PASSWORD_HASH=

# Дължина на кодовете, създавани през API. Tuya Wi-Fi бравите искат точно 7 цифри (грешка 2314 = грешна дължина)
TUYA_PASSWORD_LENGTH=7

# false = скрива бутоните „Отключи“/„Заключи“ (за брави без дистанционно отключване)
TUYA_REMOTE_UNLOCK=true

# Известия по имейл (bin/monitor.php от cron). Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
# MAIL_PASSWORD = „App password“ от https://myaccount.google.com/apppasswords (не обикновената парола)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
# false = без имейл при звънене (само аларми и батерия)
ALERT_DOORBELL=true
# Линк към уеб интерфейса в имейлите
APP_URL=

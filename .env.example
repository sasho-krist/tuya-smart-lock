# Tuya IoT Platform → Cloud → Development → вашият проект → Overview
# Регион (data center): Central Europe https://openapi.tuyaeu.com | Western Europe https://openapi-weaz.tuyaeu.com
# US https://openapi.tuyaus.com | China https://openapi.tuyacn.com | India https://openapi.tuyain.com
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=

# Една или повече брави: device_id:Етикет, разделени със запетая
TUYA_DEVICE_IDS=bf0123456789abcdef:Входна врата

# Хеш на паролата за уеб интерфейса. Генерира се с: php bin/hash-password.php
APP_PASSWORD_HASH=

# false = скрива бутоните „Отключи“/„Заключи“ (за брави без дистанционно отключване)
TUYA_REMOTE_UNLOCK=true
